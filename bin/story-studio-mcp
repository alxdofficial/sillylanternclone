#!/bin/zsh
set -eu
cd "${0:A:h:h}"
source bin/launcher-log.zsh

if [[ ! -d node_modules/@modelcontextprotocol/sdk ]]; then
  studio_log error mcp_dependencies_missing 1
  printf 'Run Start Story Studio.command once to install Story Studio dependencies.\n' >&2
  exit 1
fi

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
if command -v node >/dev/null && node -e 'process.exit(Number(process.versions.node.split(".")[0]) < 20 ? 1 : 0)'; then
  exec node mcp-server.mjs
fi

runtime="$HOME/Library/Application Support/Story Studio Runtime"
for bundled in "$runtime"/node-*-darwin-*/bin/node(N); do
  if "$bundled" -e 'process.exit(Number(process.versions.node.split(".")[0]) < 20 ? 1 : 0)'; then
    exec "$bundled" mcp-server.mjs
  fi
done

printf 'Run Start Story Studio.command once to install Node.js.\n' >&2
studio_log error mcp_node_missing 1
exit 1
